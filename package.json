{
  "name": "@first-tree-ai/context-tree",
  "version": "0.1.7",
  "description": "Durable, structured project context for coding agents: a CLI plus framework-neutral skills.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/first-tree-ai/context-tree.git"
  },
  "homepage": "https://github.com/first-tree-ai/context-tree#readme",
  "bugs": {
    "url": "https://github.com/first-tree-ai/context-tree/issues"
  },
  "keywords": [
    "agents",
    "context-tree",
    "knowledge",
    "memory"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.12.1",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "context-tree": "./dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "skills",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/cli/index.ts --format esm --out-dir dist/cli --deps.alwaysBundle '/.*/'",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "check:package": "pnpm build && pnpm package:e2e",
    "package:e2e": "node scripts/package-e2e.mjs",
    "postinstall": "node ./scripts/postinstall.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "yaml": "^2.8.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^22.16.0",
    "tsdown": "^0.21.4",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
